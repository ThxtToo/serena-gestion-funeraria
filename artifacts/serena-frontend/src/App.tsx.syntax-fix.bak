        <p>Comparte lo que necesitas y nuestro equipo dará seguimiento a tu solicitud.</p>
      </div>
      <Link className="public-primary-link" href="/solicitar-servicio">
        Iniciar solicitud <ArrowRight size={16} />
      </Link>
    </section>

    <footer className="public-footer">
      <Link href="/" className="public-brand">
        <span className="public-brand-mark">S</span>
        <span><strong>Serena</strong><small>GESTIÓN FUNERARIA</small></span>
      </Link>
      <span>Atención con respeto y dignidad.</span>
      <div><Link href="/consultar-solicitud">Consultar solicitud</Link><Link href="/personal">Acceso del personal</Link></div>
      <small>Plataforma de demostración académica.</small>
    </footer>
  </main>;
}

function PublicRequestLookup() {
  const [reference, setReference] = useState("");
  const [submittedReference, setSubmittedReference] = useState("");
  const normalizedReference = submittedReference.trim();
  const requestQuery = useGetServiceRequest(normalizedReference, {
    query: { enabled: normalizedReference.length > 0, retry: false },
  });

  const submit = (event: FormEvent<HTMLFormElement>) => {
    event.preventDefault();
    const value = reference.trim();
    if (!value) return;
    setSubmittedReference(value);
  };

  const statusLabels: Record<ServiceRequestStatusValue, string> = {
    pendiente: "Pendiente",
    en_revision: "En revisión",
    confirmada: "Confirmada",
    rechazada: "Rechazada",
    cancelada: "Cancelada",
  };

  return <div className="auth-layout public-request-layout">
    <AuthAside />
    <main className="auth-main public-request-main">
      <section className="auth-card public-request-card">
        <div className="public-card-navigation">
          <Link href="/" className="public-brand-home" aria-label="Volver al inicio de Serena">
            <Brand />
          </Link>
          <Link href="/" className="public-back-home">
            <ArrowRight size={14} className="public-back-icon" /> Volver al inicio
          </Link>
        </div>
        <p className="page-kicker">SEGUIMIENTO DE SOLICITUD</p>
        <h1 className="page-title">Consulta el estado de tu solicitud.</h1>
        <p className="auth-intro">
          Introduce el código de referencia que recibiste al registrar tu solicitud.
          Te mostraremos su estado actual.
        </p>
        <form onSubmit={submit}>
          <div className="field">
            <label htmlFor="lookup-reference">Código de referencia</label>
            <input id="lookup-reference" required maxLength={80}
              value={reference} onChange={(event) => setReference(event.target.value)}
              placeholder="Ej. SER-XXXXXXXX" autoComplete="off" />
          </div>
          <button className="primary-btn" type="submit">Consultar estado <Search size={15} /></button>
        </form>

        {normalizedReference && <>
          {requestQuery.isFetching && <div className="public-lookup-result" role="status">Consultando referencia…</div>}
          {requestQuery.isError && !requestQuery.isFetching && <div className="page-inline-error" role="alert">
            No encontramos una solicitud con esa referencia o no fue posible completar la consulta. Verifica el código e inténtalo de nuevo.
            <button className="quiet-btn" type="button" onClick={() => requestQuery.refetch()}>Reintentar</button>
          </div>}
          {requestQuery.data && <div className="public-lookup-result" aria-live="polite">
            <span className="public-eyebrow">RESULTADO DE CONSULTA</span>
            <strong className="public-lookup-code">{requestQuery.data.referenceCode}</strong>
            <span className={`pill request-status status-${requestQuery.data.status}`}>
              {statusLabels[requestQuery.data.status]}
            </span>
            <p>{requestQuery.data.message}</p>
          </div>}
        </>}

        <div className="public-request-footer">
          <Link href="/">Volver al inicio</Link>
          <Link href="/solicitar-servicio">Registrar una solicitud</Link>
        </div>
      </section>
    </main>
  </div>;
}

function PublicServiceRequest() {
  const offeringsQuery = useListPublicServiceOfferings();
  const createRequest = useCreateServiceRequest();
  const [contactName, setContactName] = useState("");
  const [contactPhone, setContactPhone] = useState("");
  const [serviceOfferingId, setServiceOfferingId] = useState("");
  const [requestedDate, setRequestedDate] = useState("");
  const [notes, setNotes] = useState("");
  const [result, setResult] = useState<ServiceRequestCreated | null>(null);
  const [error, setError] = useState("");

  const offerings = offeringsQuery.data?.serviceOfferings ?? [];

  const submit = (event: FormEvent<HTMLFormElement>) => {
    event.preventDefault();
    setError("");
    if (!serviceOfferingId) {
      setError("Selecciona el servicio que deseas solicitar.");
      return;
    }

    createRequest.mutate({
      data: {
        contactName: contactName.trim(),
        contactPhone: contactPhone.trim(),
        serviceOfferingId,
        ...(requestedDate ? { requestedDate } : {}),
        ...(notes.trim() ? { notes: notes.trim() } : {}),
      },
    }, {
      onSuccess: (response) => setResult(response),
      onError: (requestError) => setError(getErrorMessage(
        requestError,
        "No pudimos registrar tu solicitud. Comprueba los datos e inténtalo de nuevo.",
      )),
    });
  };

  return <div className="auth-layout public-request-layout">
    <AuthAside />
    <main className="auth-main public-request-main">
      <section className="auth-card public-request-card">
        <div className="public-card-navigation">
          <Link href="/" className="public-brand-home" aria-label="Volver al inicio de Serena">
            <Brand />
          </Link>
          <Link href="/" className="public-back-home">
            <ArrowRight size={14} className="public-back-icon" /> Volver al inicio
          </Link>
        </div>
        {result ? <>
          <span className="state-symbol"><CheckCircle2 size={18} /></span>
          <p className="page-kicker">SOLICITUD REGISTRADA</p>
          <h1 className="page-title">Gracias por contactar a Serena.</h1>
          <div className="success-banner" role="status">
            <CheckCircle2 size={18} />
            <span>{result.message}</span>
          </div>
          <div className="request-reference">
            <span>REFERENCIA DE SOLICITUD</span>
            <strong>{result.referenceCode}</strong>
            <small>Estado: pendiente de revisión</small>
          </div>
          <p className="auth-intro">El equipo revisará la información y se pondrá en contacto contigo. Esta solicitud no representa una confirmación de disponibilidad ni del servicio.</p>
          <button className="primary-btn" type="button" onClick={() => {
            setResult(null);
            setContactName("");
            setContactPhone("");
            setServiceOfferingId("");
            setRequestedDate("");
            setNotes("");
          }}>Registrar otra solicitud <ArrowRight size={15} /></button>
        </> : <>
          <p className="page-kicker">ATENCIÓN Y ACOMPAÑAMIENTO</p>
          <h1 className="page-title">Estamos aquí para ayudarte.</h1>
          <p className="auth-intro">Comparte tus datos y el servicio que necesitas. Nuestro equipo revisará tu solicitud y se comunicará contigo.</p>

          {error && <div className="page-inline-error" role="alert">{error}</div>}

          {offeringsQuery.isLoading ? <div className="loading-state">Cargando servicios disponibles…</div>
          : offeringsQuery.isError ? <div className="error-state">
              <strong>No pudimos cargar los servicios.</strong>
              <p>Comprueba tu conexión e inténtalo de nuevo.</p>
              <button className="quiet-btn" type="button" onClick={() => offeringsQuery.refetch()}>Reintentar</button>
            </div>
          : offerings.length === 0 ? <div className="empty-state">
              <strong>Catálogo temporalmente no disponible</strong>
              <p>En este momento no hay servicios publicados para solicitar.</p>
            </div>
          : <form onSubmit={submit}>
              <div className="field">
                <label htmlFor="request-contact-name">Nombre completo</label>
                <input id="request-contact-name" required minLength={2} maxLength={120}
                  autoComplete="name" value={contactName}
                  onChange={(event) => setContactName(event.target.value)}
                  placeholder="Nombre y apellidos" />
              </div>
              <div className="field">
                <label htmlFor="request-contact-phone">Teléfono de contacto</label>
                <input id="request-contact-phone" required minLength={5} maxLength={30}
                  type="tel" autoComplete="tel" value={contactPhone}
                  onChange={(event) => setContactPhone(event.target.value)}
                  placeholder="Número de teléfono" />
              </div>
              <div className="field">
                <label htmlFor="request-offering">Servicio que necesitas</label>
                <select id="request-offering" required value={serviceOfferingId}
                  onChange={(event) => setServiceOfferingId(event.target.value)}>
                  <option value="">Selecciona un servicio</option>
                  {offerings.map((offering) => <option key={offering.id} value={offering.id}>{offering.name}</option>)}
                </select>
              </div>
              <div className="field">
                <label htmlFor="request-date">Fecha de preferencia (opcional)</label>
                <input id="request-date" type="date" value={requestedDate}
                  onChange={(event) => setRequestedDate(event.target.value)} />
              </div>
              <div className="field">
                <label htmlFor="request-notes">Información adicional (opcional)</label>
                <textarea id="request-notes" maxLength={1000} rows={4}
                  value={notes} onChange={(event) => setNotes(event.target.value)}
                  placeholder="Cuéntanos brevemente cómo podemos ayudarte." />
              </div>
              <div className="form-note"><ShieldCheck size={15} /><span>Tu solicitud será revisada por nuestro equipo. El envío no confirma la disponibilidad del servicio.</span></div>
              <button className="primary-btn" type="submit" disabled={createRequest.isPending}>
                {createRequest.isPending ? "Enviando solicitud…" : <>Enviar solicitud <Send size={15} /></>}
              </button>
            </form>}
          <div className="public-request-footer"><Link href="/personal">Acceso para personal Serena</Link></div>
        </>}
      </section>
    </main>
  </div>;
}

function ServiceOfferingForm({
  offering, onClose, onSaved,
}: {
  offering?: ServiceOffering;
  onClose: () => void;
  onSaved: () => void;
}) {
  const createOffering = useCreateServiceOffering();
  const updateOffering = useUpdateServiceOffering();
  const [name, setName] = useState(offering?.name ?? "");
  const [description, setDescription] = useState(offering?.description ?? "");
  const [error, setError] = useState("");
  const pending = createOffering.isPending || updateOffering.isPending;

  const submit = (event: FormEvent<HTMLFormElement>) => {
    event.preventDefault();
    setError("");
    const data = { name: name.trim(), description: description.trim() || null };
    const callbacks = {
      onSuccess: () => onSaved(),
      onError: (requestError: unknown) => setError(getErrorMessage(
        requestError,
        "No pudimos guardar el servicio. Comprueba si ya existe otro con ese nombre.",
      )),
    };
    if (offering) {
      updateOffering.mutate({ serviceOfferingId: offering.id, data }, callbacks);
    } else {
      createOffering.mutate({ data }, callbacks);
    }
  };

  return <div className="modal-backdrop" role="presentation"
    onMouseDown={(event) => { if (event.target === event.currentTarget && !pending) onClose(); }}>
    <section className="modal" role="dialog" aria-modal="true" aria-labelledby="offering-form-title">
      <div className="modal-head">
        <div><h2 id="offering-form-title">{offering ? "Editar servicio" : "Nuevo servicio"}</h2>
          <p>Los servicios activos estarán disponibles en el formulario público.</p></div>
        <button className="icon-button" type="button" aria-label="Cerrar" onClick={onClose}>×</button>
      </div>
      {error && <div className="page-inline-error" role="alert">{error}</div>}
      <form onSubmit={submit}>
        <div className="field">
          <label htmlFor="offering-name">Nombre del servicio</label>
          <input id="offering-name" required minLength={2} maxLength={120}
            value={name} onChange={(event) => setName(event.target.value)}
            placeholder="Nombre del servicio" />
        </div>
        <div className="field">
          <label htmlFor="offering-description">Descripción (opcional)</label>
          <textarea id="offering-description" rows={4} maxLength={1000}
            value={description} onChange={(event) => setDescription(event.target.value)}
            placeholder="Describe brevemente el servicio." />
        </div>
        <div className="modal-actions">
          <button className="quiet-btn" type="button" onClick={onClose} disabled={pending}>Cancelar</button>
          <button className="secondary-btn" type="submit" disabled={pending}>
            {pending ? "Guardando…" : <><Check size={15} /> Guardar servicio</>}
          </button>
        </div>
      </form>
    </section>
  </div>;
}

function AdminServiceOfferings({ session }: { session: AuthenticatedSession }) {
  const offeringsQuery = useListAdminServiceOfferings();
  const updateOffering = useUpdateServiceOffering();
  const client = useQueryClient();
  const [editing, setEditing] = useState<ServiceOffering | null>(null);
  const [creating, setCreating] = useState(false);
  const [error, setError] = useState("");
  const [notice, setNotice] = useState("");

  const refreshCatalog = () => {
    client.invalidateQueries({ queryKey: getListAdminServiceOfferingsQueryKey() });
    client.invalidateQueries({ queryKey: getListPublicServiceOfferingsQueryKey() });
    setCreating(false);
    setEditing(null);
    setNotice("El catálogo se actualizó correctamente.");
    setError("");
  };

  const toggleActive = (offering: ServiceOffering) => {
    setError("");
    setNotice("");
    updateOffering.mutate({
      serviceOfferingId: offering.id,
      data: { isActive: !offering.isActive },
    }, {
      onSuccess: () => {
        client.invalidateQueries({ queryKey: getListAdminServiceOfferingsQueryKey() });
        client.invalidateQueries({ queryKey: getListPublicServiceOfferingsQueryKey() });
        setNotice(offering.isActive
          ? "El servicio se desactivó. Se conservarán las solicitudes históricas."
          : "El servicio volvió a estar disponible en el formulario público.");
      },
      onError: (requestError) => setError(getErrorMessage(
        requestError, "No pudimos cambiar el estado del servicio.",
      )),
    });
  };

  const offerings = offeringsQuery.data?.serviceOfferings ?? [];

  return <WorkspaceShell session={session}>
    <section className="page-content">
      <p className="page-kicker">ADMINISTRACIÓN</p>
      <h1 className="page-title">Catálogo de servicios.</h1>
      <p className="page-subtitle">Administra los servicios que las personas pueden seleccionar al enviar una solicitud. Desactivar un servicio no elimina su historial.</p>

      <div className="admin-actions">
        <span className="catalog-count">{offerings.length} {offerings.length === 1 ? "servicio registrado" : "servicios registrados"}</span>
        <button className="secondary-btn" type="button" onClick={() => { setCreating(true); setNotice(""); }}>
          <Plus size={15} /> Nuevo servicio
        </button>
      </div>

      {notice && <div className="success-banner" role="status"><CheckCircle2 size={17} /><span>{notice}</span></div>}
      {error && <div className="page-inline-error" role="alert">{error}</div>}

      {offeringsQuery.isLoading ? <div className="loading-state">Cargando catálogo…</div>
      : offeringsQuery.isError ? <div className="error-state">
          <strong>No pudimos cargar el catálogo.</strong>
          <p>Comprueba tu sesión y vuelve a intentarlo.</p>
          <button className="quiet-btn" type="button" onClick={() => offeringsQuery.refetch()}>Reintentar</button>
        </div>
      : offerings.length === 0 ? <div className="empty-state">
          <strong>Aún no hay servicios</strong>
          <p>Crea el primer servicio para publicarlo en el formulario de solicitudes.</p>
        </div>
      : <div className="table-wrap">
          <table className="employee-table">
            <thead><tr><th>Servicio</th><th>Descripción</th><th>Estado</th><th>Acciones</th></tr></thead>
            <tbody>{offerings.map((offering) => <tr key={offering.id}>
              <td><strong>{offering.name}</strong></td>
              <td>{offering.description || "—"}</td>
              <td><span className={`pill ${offering.isActive ? "active" : "inactive"}`}>{offering.isActive ? "Activo" : "Inactivo"}</span></td>
              <td><div className="catalog-row-actions">
                <button className="quiet-btn" type="button" onClick={() => { setEditing(offering); setNotice(""); }} aria-label={`Editar ${offering.name}`}><Pencil size={14} /> Editar</button>
                <button className="quiet-btn" type="button" disabled={updateOffering.isPending}
                  onClick={() => toggleActive(offering)} aria-label={`${offering.isActive ? "Desactivar" : "Activar"} ${offering.name}`}>
                  <Power size={14} /> {offering.isActive ? "Desactivar" : "Activar"}
                </button>
              </div></td>
            </tr>)}</tbody>
          </table>
        </div>}

      <div className="catalog-public-link"><span>Formulario público de solicitudes</span><Link href="/solicitar-servicio">Ver formulario <ArrowRight size={14} /></Link></div>
    </section>
    {(creating || editing) && <ServiceOfferingForm
      offering={editing ?? undefined}
      onClose={() => { setCreating(false); setEditing(null); }}
      onSaved={refreshCatalog}
    />}
  </WorkspaceShell>;
}


const REQUEST_STATUSES: ServiceRequestStatusValue[] = [
  "pendiente", "en_revision", "confirmada", "rechazada", "cancelada",
];

const STATUS_LABELS: Record<ServiceRequestStatusValue, string> = {
  pendiente: "Pendiente",
  en_revision: "En revisión",
  confirmada: "Confirmada",
  rechazada: "Rechazada",
  cancelada: "Cancelada",
};

const NEXT_STATUSES: Record<ServiceRequestStatusValue, ServiceRequestStatusValue[]> = {
  pendiente: ["en_revision", "rechazada", "cancelada"],
  en_revision: ["confirmada", "rechazada", "cancelada"],
  confirmada: ["cancelada"],
  rechazada: [],
  cancelada: [],
};

function formatRequestDate(value?: string | null) {
  if (!value) return "Sin fecha definida";
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return value;
  return new Intl.DateTimeFormat("es-MX", {
    dateStyle: "medium",
    timeStyle: "short",
  }).format(date);
}

function AdminServiceRequests({ session }: { session: AuthenticatedSession }) {
  const client = useQueryClient();
  const [statusFilter, setStatusFilter] = useState("");
  const [search, setSearch] = useState("");
  const [page, setPage] = useState(1);
  const [selectedId, setSelectedId] = useState<string | null>(null);
  const [nextStatus, setNextStatus] = useState<ServiceRequestStatusValue | "">("");
  const [observation, setObservation] = useState("");
  const [error, setError] = useState("");
  const [notice, setNotice] = useState("");

  const listQuery = useListAdminServiceRequests({
    status: statusFilter ? statusFilter as ServiceRequestStatusValue : undefined,
    search: search.trim() || undefined,
    page,
    limit: 20,
  });

  const detailQuery = useGetAdminServiceRequest(selectedId ?? "", {
    query: { enabled: Boolean(selectedId) },
  });

  const updateStatus = useUpdateAdminServiceRequestStatus();

  const requests = listQuery.data?.serviceRequests ?? [];
  const pagination = listQuery.data?.pagination;
  const selectedRequest = detailQuery.data?.serviceRequest;
  const availableStatuses = selectedRequest
    ? NEXT_STATUSES[selectedRequest.status]
    : [];

  const openDetail = (requestId: string) => {
    setSelectedId(requestId);
    setNextStatus("");
    setObservation("");
    setError("");
    setNotice("");
  };

  const closeDetail = () => {
    setSelectedId(null);
    setNextStatus("");
    setObservation("");
    setError("");
  };

  const submitStatus = (event: FormEvent<HTMLFormElement>) => {
    event.preventDefault();
    if (!selectedId || !nextStatus) return;

    setError("");
    setNotice("");

    updateStatus.mutate({
      requestId: selectedId,
      data: {
        status: nextStatus,
        ...(observation.trim() ? { observation: observation.trim() } : {}),
      },
    }, {
      onSuccess: () => {
        client.invalidateQueries({ queryKey: getListAdminServiceRequestsQueryKey() });
        client.invalidateQueries({ queryKey: getGetAdminServiceRequestQueryKey(selectedId) });
        setNextStatus("");
        setObservation("");
        setNotice("El estado de la solicitud se actualizó y quedó registrado en el historial.");
      },
      onError: (mutationError) => setError(getErrorMessage(
        mutationError,
        "No pudimos actualizar el estado. Es posible que la solicitud haya cambiado; vuelve a cargarla.",
      )),
    });
  };

  return <WorkspaceShell session={session}>
    <section className="page-content">
      <p className="page-kicker">ADMINISTRACIÓN</p>
      <h1 className="page-title">Seguimiento de solicitudes.</h1>
      <p className="page-subtitle">
        Consulta las solicitudes recibidas, revisa sus datos y registra cada cambio de estado.
        Las modificaciones quedan documentadas en el historial.
      </p>

      <div className="request-filters">
        <label className="request-search">
          <Search size={16} />
          <input
            type="search"
            value={search}
            onChange={(event) => { setSearch(event.target.value); setPage(1); }}
            placeholder="Buscar por referencia, contacto o teléfono"
            aria-label="Buscar solicitudes"
          />
        </label>
        <label className="request-status-filter">
          <span>Estado</span>
          <select value={statusFilter} onChange={(event) => { setStatusFilter(event.target.value); setPage(1); }}>
            <option value="">Todos los estados</option>
            {REQUEST_STATUSES.map((status) =>
              <option key={status} value={status}>{STATUS_LABELS[status]}</option>
            )}
          </select>
        </label>
      </div>

      {error && !selectedId && <div className="page-inline-error" role="alert">{error}</div>}
      {notice && !selectedId && <div className="success-banner" role="status">{notice}</div>}

      <div className="admin-actions">
        <span className="catalog-count">
          {pagination ? `${pagination.total} solicitudes encontradas` : "Solicitudes recibidas"}
        </span>
        <button className="quiet-btn" type="button" onClick={() => listQuery.refetch()}>
          <RefreshCw size={14} /> Actualizar
        </button>
      </div>

      {listQuery.isLoading ? <div className="loading-state">Cargando solicitudes…</div>
      : listQuery.isError ? <div className="error-state">
          <strong>No pudimos cargar las solicitudes.</strong>
          <p>Comprueba tu sesión y vuelve a intentarlo.</p>
          <button className="quiet-btn" type="button" onClick={() => listQuery.refetch()}>Reintentar</button>
        </div>
      : requests.length === 0 ? <div className="empty-state">
          <strong>No hay solicitudes para mostrar</strong>
          <p>Cuando se reciban solicitudes, aparecerán en este listado.</p>
        </div>
      : <div className="table-wrap">
          <table className="employee-table request-table">
            <thead><tr>
              <th>Referencia</th><th>Contacto</th><th>Servicio</th><th>Fecha solicitada</th><th>Estado</th><th>Detalle</th>
            </tr></thead>
            <tbody>{requests.map((request) => <tr key={request.id}>
              <td><strong className="request-reference-cell">{request.referenceCode}</strong></td>
              <td><span className="request-contact"><strong>{request.contactName}</strong><small>{request.contactPhone}</small></span></td>
              <td>{request.serviceType}</td>
              <td>{request.requestedDate ? formatRequestDate(request.requestedDate) : "No especificada"}</td>
              <td><span className={`pill request-status status-${request.status}`}>{STATUS_LABELS[request.status]}</span></td>
              <td><button className="table-action" type="button" onClick={() => openDetail(request.id)}>Ver solicitud</button></td>
            </tr>)}</tbody>
          </table>
        </div>}

      {pagination && pagination.totalPages > 1 && <div className="request-pagination">
        <span>Página {pagination.page} de {pagination.totalPages}</span>
        <div>
          <button className="table-action" type="button" disabled={page <= 1} onClick={() => setPage((current) => Math.max(1, current - 1))}>Anterior</button>
          <button className="table-action" type="button" disabled={page >= pagination.totalPages} onClick={() => setPage((current) => current + 1)}>Siguiente</button>
        </div>
      </div>}
    </section>

    {selectedId && <div className="modal-backdrop request-detail-backdrop" onMouseDown={(event) => {
      if (event.target === event.currentTarget && !updateStatus.isPending) closeDetail();
    }}>
      <section className="modal request-detail-modal" role="dialog" aria-modal="true" aria-labelledby="request-detail-title">
        <div className="modal-head">
          <div>
            <p className="page-kicker">EXPEDIENTE DE SOLICITUD</p>
            <h2 id="request-detail-title">{selectedRequest?.referenceCode ?? "Detalle de solicitud"}</h2>
            <p>Información de contacto, estado actual e historial de seguimiento.</p>
          </div>
          <button className="icon-button" type="button" onClick={closeDetail} disabled={updateStatus.isPending} aria-label="Cerrar detalle"><X size={17} /></button>
        </div>

        {detailQuery.isLoading ? <div className="loading-state">Cargando expediente…</div>
        : detailQuery.isError || !selectedRequest ? <div className="error-state">
            <strong>No pudimos cargar el expediente.</strong>
            <p>Vuelve a intentarlo.</p>
            <button className="quiet-btn" type="button" onClick={() => detailQuery.refetch()}>Reintentar</button>
          </div>
        : <>
            {error && <div className="page-inline-error" role="alert">{error}</div>}
            {notice && <div className="success-banner" role="status">{notice}</div>}

            <div className="request-detail-grid">
              <div><small>Persona de contacto</small><strong>{selectedRequest.contactName}</strong></div>
              <div><small>Teléfono</small><strong>{selectedRequest.contactPhone}</strong></div>
              <div><small>Servicio solicitado</small><strong>{selectedRequest.serviceType}</strong></div>
              <div><small>Fecha solicitada</small><strong>{formatRequestDate(selectedRequest.requestedDate)}</strong></div>
              <div><small>Recibida</small><strong>{formatRequestDate(selectedRequest.createdAt)}</strong></div>
              <div><small>Estado actual</small><strong><span className={`pill request-status status-${selectedRequest.status}`}>{STATUS_LABELS[selectedRequest.status]}</span></strong></div>
            </div>

            {selectedRequest.notes && <div className="request-notes">
              <small>Notas de la solicitud</small><p>{selectedRequest.notes}</p>
            </div>}

            <div className="request-history">
              <h3><Clock3 size={16} /> Historial de estados</h3>
              {(detailQuery.data?.history ?? []).length === 0
                ? <p className="request-history-empty">No hay movimientos registrados.</p>
                : <ol>{(detailQuery.data?.history ?? []).map((entry) => <li key={entry.id}>
                    <span className="request-history-dot" />
                    <div>
                      <strong>{entry.previousStatus ? `${STATUS_LABELS[entry.previousStatus]} → ` : ""}{STATUS_LABELS[entry.newStatus]}</strong>
                      <small>{formatRequestDate(entry.createdAt)} · {entry.changedByName || "Formulario público"}</small>
                      {entry.observation && <p>{entry.observation}</p>}
                    </div>
                  </li>)}</ol>}
            </div>

            {availableStatuses.length > 0 ? <form className="request-update-form" onSubmit={submitStatus}>
              <h3>Registrar cambio de estado</h3>
              <label>
                Nuevo estado
                <select required value={nextStatus} onChange={(event) => setNextStatus(event.target.value as ServiceRequestStatusValue | "")}>
                  <option value="">Selecciona el nuevo estado</option>
                  {availableStatuses.map((status) => <option key={status} value={status}>{STATUS_LABELS[status]}</option>)}
                </select>
              </label>
              <label>
                Observación <span>(opcional)</span>
                <textarea rows={3} maxLength={1000} value={observation} onChange={(event) => setObservation(event.target.value)} placeholder="Añade contexto sobre la decisión o gestión realizada." />
              </label>
              <button className="primary-btn" type="submit" disabled={!nextStatus || updateStatus.isPending}>
                {updateStatus.isPending ? <RefreshCw size={15} /> : <Check size={15} />}
                {updateStatus.isPending ? "Guardando…" : "Guardar cambio"}
              </button>
            </form> : <p className="request-terminal-note">Esta solicitud no admite más cambios de estado.</p>}
          </>}
      </section>
    </div>}
  </WorkspaceShell>;
}


const FUNERAL_STATUS_LABELS: Record<FuneralCaseStatusValue, string> = {
  abierto: "Abierto",
  en_preparacion: "En preparación",
  programado: "Programado",
  en_ejecucion: "En ejecución",
  finalizado: "Finalizado",
  cancelado: "Cancelado",
};

const NEXT_FUNERAL_STATUSES: Record<FuneralCaseStatusValue, FuneralCaseStatusValue[]> = {
  abierto: ["en_preparacion", "programado", "cancelado"],
  en_preparacion: ["programado", "en_ejecucion", "cancelado"],
  programado: ["en_preparacion", "en_ejecucion", "cancelado"],
  en_ejecucion: ["finalizado", "cancelado"],
  finalizado: [],
  cancelado: [],
};

function AdminFuneralCases({ session }: { session: AuthenticatedSession }) {
  const client = useQueryClient();
  const [statusFilter, setStatusFilter] = useState("");
  const [employeeFilter, setEmployeeFilter] = useState("");
  const [search, setSearch] = useState("");
  const [page, setPage] = useState(1);
  const [selectedId, setSelectedId] = useState<string | null>(null);
  const [showCreate, setShowCreate] = useState(false);
  const [requestPage, setRequestPage] = useState(1);
  const [sourceRequestId, setSourceRequestId] = useState("");
  const [deceasedName, setDeceasedName] = useState("");
  const [dateOfDeath, setDateOfDeath] = useState("");
  const [serviceLocation, setServiceLocation] = useState("");
  const [responsibleName, setResponsibleName] = useState("");
  const [responsiblePhone, setResponsiblePhone] = useState("");
  const [assignedEmployeeId, setAssignedEmployeeId] = useState("");
  const [notes, setNotes] = useState("");
  const [nextStatus, setNextStatus] = useState<FuneralCaseStatusValue | "">("");
  const [observation, setObservation] = useState("");
  const [error, setError] = useState("");
  const [notice, setNotice] = useState("");

  const listQuery = useListAdminFuneralCases({
    status: statusFilter ? statusFilter as FuneralCaseStatusValue : undefined,
    assignedEmployeeId: employeeFilter || undefined,
    search: search.trim() || undefined,
    page,
    limit: 20,
  });

  const detailQuery = useGetAdminFuneralCase(selectedId ?? "", {
    query: { enabled: Boolean(selectedId) },
  });

  const employeesQuery = useListEmployees();
  const requestsQuery = useListAdminServiceRequests({
    status: "confirmada",
    page: requestPage,
    limit: 100,
  });

  const createCase = useCreateAdminFuneralCase();
  const updateStatus = useUpdateAdminFuneralCaseStatus();

  const cases = listQuery.data?.funeralCases ?? [];
  const pagination = listQuery.data?.pagination;
  const selectedCase = detailQuery.data?.funeralCase;
  const history = detailQuery.data?.history ?? [];
  const sourceRequests = requestsQuery.data?.serviceRequests ?? [];
  const requestPagination = requestsQuery.data?.pagination;
  const employees = (employeesQuery.data?.employees ?? []).filter(
    (employee) => employee.role === "empleado" && employee.isActive,
  );
  const availableStatuses = selectedCase
    ? NEXT_FUNERAL_STATUSES[selectedCase.status]
    : [];

  function resetCreateForm() {
    setSourceRequestId("");
    setDeceasedName("");
    setDateOfDeath("");
    setServiceLocation("");
    setResponsibleName("");
    setResponsiblePhone("");
    setAssignedEmployeeId("");
    setNotes("");
    setRequestPage(1);
  }

  function closeCreate() {
    setShowCreate(false);
    setError("");
    resetCreateForm();
  }

  function handleSourceRequestChange(id: string) {
    setSourceRequestId(id);
    const request = sourceRequests.find((item) => item.id === id);
    if (request) {
      setResponsibleName(request.contactName);
      setResponsiblePhone(request.contactPhone);
    }
  }

  function submitCreate(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    setError("");
    setNotice("");

    if (!sourceRequestId) {
      setError("Selecciona una solicitud confirmada.");
      return;
    }

    const payload: CreateFuneralCaseInput = {
      serviceRequestId: sourceRequestId,
      deceasedFullName: deceasedName.trim(),
      ...(dateOfDeath ? { deceasedDateOfDeath: new Date(`${dateOfDeath}T12:00:00`).toISOString() } : {}),
      ...(serviceLocation.trim() ? { serviceLocation: serviceLocation.trim() } : {}),
      responsibleContactName: responsibleName.trim(),
      responsibleContactPhone: responsiblePhone.trim(),
      ...(assignedEmployeeId ? { assignedEmployeeId } : {}),
      ...(notes.trim() ? { notes: notes.trim() } : {}),
    };

    createCase.mutate({ data: payload }, {
      onSuccess: async (result) => {
        await client.invalidateQueries({ queryKey: getListAdminFuneralCasesQueryKey() });
        closeCreate();
        setSelectedId(result.funeralCase.id);
        setNotice(`Expediente ${result.funeralCase.caseNumber} creado correctamente.`);
      },
      onError: (mutationError) => {
        setError(getErrorMessage(mutationError, "No fue posible crear el expediente. Verifica que la solicitud siga confirmada y no tenga un expediente asociado."));
      },
    });
  }

  function submitStatus(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    if (!selectedId || !nextStatus) return;
    setError("");
    setNotice("");

    updateStatus.mutate({
      caseId: selectedId,
      data: {
        status: nextStatus,
        observation: observation.trim() || undefined,
      },
    }, {
      onSuccess: async () => {
        await Promise.all([
          client.invalidateQueries({ queryKey: getListAdminFuneralCasesQueryKey() }),
          client.invalidateQueries({ queryKey: getGetAdminFuneralCaseQueryKey(selectedId) }),
        ]);
        setNextStatus("");
        setObservation("");
        setNotice("El estado del expediente se actualizó y quedó registrado en el historial.");
      },
      onError: (mutationError) => {
        setError(getErrorMessage(mutationError, "No fue posible actualizar el estado del expediente."));
      },
    });
  }

  function openDetail(id: string) {
    setError("");
    setNotice("");
    setNextStatus("");
    setObservation("");
    setSelectedId(id);
  }

  return <WorkspaceShell session={session}>
    <section className="page-content">
      <p className="page-kicker">GESTIÓN OPERATIVA</p>
      <div className="page-heading-row">
        <div>
          <h1 className="page-title">Expedientes funerarios</h1>
          <p className="page-subtitle">Organiza los servicios confirmados, responsables y movimientos de cada expediente.</p>
        </div>
        <button className="primary-btn" type="button" onClick={() => { setError(""); setShowCreate(true); }}>
          <Plus size={15} /> Nuevo expediente
        </button>
      </div>

      {notice && <div className="success-banner" role="status">{notice}</div>}
      {error && !showCreate && !selectedId && <div className="page-inline-error" role="alert">{error}</div>}

      <div className="request-filters">
        <label className="request-search">
          <Search size={16} />
          <input
            aria-label="Buscar expedientes"
            value={search}
            onChange={(event) => { setSearch(event.target.value); setPage(1); }}
            placeholder="Buscar por expediente, solicitud, fallecido o contacto…"
          />
        </label>
        <label className="request-status-filter">
          <span>Estado</span>
          <select value={statusFilter} onChange={(event) => { setStatusFilter(event.target.value); setPage(1); }}>
            <option value="">Todos los estados</option>
            {Object.entries(FUNERAL_STATUS_LABELS).map(([value, label]) =>
              <option key={value} value={value}>{label}</option>
            )}
          </select>
        </label>
        <label className="request-status-filter">
          <span>Personal asignado</span>
          <select value={employeeFilter} onChange={(event) => { setEmployeeFilter(event.target.value); setPage(1); }}>
            <option value="">Todo el personal</option>
            {employees.map((employee) => <option key={employee.id} value={employee.id}>{employee.fullName}</option>)}
          </select>
        </label>
      </div>

      <div className="table-wrap">
        <table className="employee-table request-table">
          <thead><tr>
            <th>Expediente</th>
            <th>Fallecido</th>
            <th>Contacto responsable</th>
            <th>Personal asignado</th>
            <th>Estado</th>
            <th>Creación</th>
            <th></th>
          </tr></thead>
          <tbody>
            {listQuery.isLoading ? <tr><td colSpan={7}><div className="loading-state">Cargando expedientes…</div></td></tr>
              : listQuery.isError ? <tr><td colSpan={7}><div className="error-state"><strong>No se pudieron cargar los expedientes.</strong><p>Comprueba tu conexión e inténtalo de nuevo.</p><button className="secondary-btn" onClick={() => listQuery.refetch()}>Reintentar</button></div></td></tr>
              : cases.length === 0 ? <tr><td colSpan={7}><div className="empty-state"><strong>No hay expedientes para mostrar.</strong><p>Cuando conviertas una solicitud confirmada en expediente, aparecerá aquí.</p></div></td></tr>
              : cases.map((item) => <tr key={item.id}>
                <td><span className="request-reference-cell">{item.caseNumber}</span><small className="funeral-subline">Solicitud {item.serviceRequestReferenceCode}</small></td>
                <td><strong>{item.deceasedFullName}</strong></td>
                <td><div className="request-contact"><strong>{item.responsibleContactName}</strong><small>{item.responsibleContactPhone}</small></div></td>
                <td>{item.assignedEmployeeName || <span className="muted-text">Sin asignar</span>}</td>
                <td><span className={`pill request-status funeral-status-${item.status}`}>{FUNERAL_STATUS_LABELS[item.status]}</span></td>
                <td>{formatRequestDate(new Date(item.createdAt).toISOString())}</td>
                <td><button className="table-action" type="button" onClick={() => openDetail(item.id)}>Ver expediente</button></td>
              </tr>)}
          </tbody>
        </table>
      </div>

      {pagination && <div className="request-pagination">
        <span>{pagination.total} expediente(s) · Página {pagination.page} de {pagination.totalPages}</span>
        <div>
          <button className="secondary-btn" type="button" disabled={pagination.page <= 1} onClick={() => setPage((value) => Math.max(1, value - 1))}>Anterior</button>
          <button className="secondary-btn" type="button" disabled={pagination.page >= pagination.totalPages} onClick={() => setPage((value) => value + 1)}>Siguiente</button>
        </div>
      </div>}
    </section>

    {showCreate && <div className="modal-backdrop request-detail-backdrop" onMouseDown={(event) => { if (event.target === event.currentTarget) closeCreate(); }}>
      <form className="modal request-detail-modal funeral-modal" onSubmit={submitCreate}>
        <div className="modal-head">
          <div><p className="page-kicker">ALTA DE EXPEDIENTE</p><h2>Nuevo expediente</h2><p>El expediente se crea a partir de una solicitud que ya fue confirmada.</p></div>
          <button className="icon-button" type="button" aria-label="Cerrar" onClick={closeCreate}><X size={16} /></button>
        </div>

        {error && <div className="page-inline-error" role="alert">{error}</div>}

        <div className="funeral-form-grid">
          <label className="funeral-field funeral-field-full">Solicitud confirmada
            <select required value={sourceRequestId} onChange={(event) => handleSourceRequestChange(event.target.value)}>
              <option value="">Selecciona una solicitud</option>
              {sourceRequests.map((request) => <option key={request.id} value={request.id}>{request.referenceCode} · {request.contactName} · {request.serviceType}</option>)}
            </select>
            {requestsQuery.isLoading && <small>Cargando solicitudes confirmadas…</small>}
            {requestPagination && <small>{requestPagination.total} solicitudes confirmadas. Página {requestPagination.page} de {requestPagination.totalPages}.</small>}
          </label>
          {requestPagination && requestPagination.totalPages > 1 && <div className="funeral-source-pages">
            <button className="secondary-btn" type="button" disabled={requestPage <= 1} onClick={() => setRequestPage((value) => Math.max(1, value - 1))}>Solicitudes anteriores</button>
            <button className="secondary-btn" type="button" disabled={requestPage >= requestPagination.totalPages} onClick={() => setRequestPage((value) => value + 1)}>Más solicitudes</button>
          </div>}

          <label className="funeral-field funeral-field-full">Nombre completo del fallecido
            <input required minLength={2} maxLength={160} value={deceasedName} onChange={(event) => setDeceasedName(event.target.value)} />
          </label>
          <label className="funeral-field">Fecha de fallecimiento <span>(opcional)</span>
            <input type="date" value={dateOfDeath} onChange={(event) => setDateOfDeath(event.target.value)} />
          </label>
          <label className="funeral-field">Lugar del servicio <span>(opcional)</span>
            <input maxLength={240} value={serviceLocation} onChange={(event) => setServiceLocation(event.target.value)} placeholder="Dirección o lugar" />
          </label>
          <label className="funeral-field">Contacto responsable
            <input required minLength={2} maxLength={120} value={responsibleName} onChange={(event) => setResponsibleName(event.target.value)} />
          </label>
          <label className="funeral-field">Teléfono del responsable
            <input required minLength={5} maxLength={30} value={responsiblePhone} onChange={(event) => setResponsiblePhone(event.target.value)} />
          </label>
          <label className="funeral-field funeral-field-full">Asignar a personal activo <span>(opcional)</span>
            <select value={assignedEmployeeId} onChange={(event) => setAssignedEmployeeId(event.target.value)}>
              <option value="">Sin asignar</option>
              {employees.map((employee) => <option key={employee.id} value={employee.id}>{employee.fullName}</option>)}
            </select>
          </label>
          <label className="funeral-field funeral-field-full">Notas internas <span>(opcional)</span>
            <textarea rows={3} maxLength={2000} value={notes} onChange={(event) => setNotes(event.target.value)} placeholder="Información operativa relevante para el equipo." />
          </label>
        </div>
        <div className="modal-actions">
          <button className="secondary-btn" type="button" onClick={closeCreate}>Cancelar</button>
          <button className="primary-btn" type="submit" disabled={createCase.isPending || requestsQuery.isLoading || !sourceRequestId}>
            {createCase.isPending ? <RefreshCw size={15} /> : <Check size={15} />}
            {createCase.isPending ? "Creando…" : "Crear expediente"}
          </button>
        </div>
      </form>
    </div>}

    {selectedId && <div className="modal-backdrop request-detail-backdrop" onMouseDown={(event) => { if (event.target === event.currentTarget) setSelectedId(null); }}>
      <section className="modal request-detail-modal">
        <div className="modal-head">
          <div><p className="page-kicker">FICHA OPERATIVA</p><h2>{selectedCase?.caseNumber ?? "Expediente"}</h2><p>Solicitud relacionada: {selectedCase?.serviceRequestReferenceCode ?? "Cargando…"}</p></div>
          <button className="icon-button" type="button" aria-label="Cerrar" onClick={() => setSelectedId(null)}><X size={16} /></button>
        </div>

        {detailQuery.isLoading ? <div className="loading-state">Cargando expediente…</div>
          : detailQuery.isError || !selectedCase ? <div className="error-state"><strong>No se pudo cargar el expediente.</strong><p>Comprueba tu conexión e inténtalo de nuevo.</p><button className="secondary-btn" onClick={() => detailQuery.refetch()}>Reintentar</button></div>
          : <>
            <div className="funeral-detail-status">
              <span className={`pill request-status funeral-status-${selectedCase.status}`}>{FUNERAL_STATUS_LABELS[selectedCase.status]}</span>
              <span>Actualizado: {formatRequestDate(new Date(selectedCase.updatedAt).toISOString())}</span>
            </div>
            <div className="request-detail-grid">
              <div><small>Fallecido</small><strong>{selectedCase.deceasedFullName}</strong></div>
              <div><small>Fecha de fallecimiento</small><strong>{selectedCase.deceasedDateOfDeath ? formatRequestDate(new Date(selectedCase.deceasedDateOfDeath).toISOString()) : "No registrada"}</strong></div>
              <div><small>Lugar del servicio</small><strong>{selectedCase.serviceLocation || "No especificado"}</strong></div>
              <div><small>Personal asignado</small><strong>{selectedCase.assignedEmployeeName || "Sin asignar"}</strong></div>
              <div><small>Contacto responsable</small><strong>{selectedCase.responsibleContactName}</strong></div>
              <div><small>Teléfono responsable</small><strong>{selectedCase.responsibleContactPhone}</strong></div>
              <div><small>Fecha de creación</small><strong>{formatRequestDate(new Date(selectedCase.createdAt).toISOString())}</strong></div>
              <div><small>Identificador de solicitud</small><strong>{selectedCase.serviceRequestReferenceCode}</strong></div>
            </div>
            {selectedCase.notes && <div className="request-notes"><small>Notas internas</small><p>{selectedCase.notes}</p></div>}

            <div className="request-history">
              <h3><Clock3 size={16} /> Historial del expediente</h3>
              {history.length === 0 ? <p className="request-history-empty">No hay movimientos registrados.</p>
                : <ol>{history.map((entry) => <li key={entry.id}>
                  <span className="request-history-dot" />
                  <div>
                    <strong>{entry.previousStatus ? `${FUNERAL_STATUS_LABELS[entry.previousStatus]} → ` : ""}{FUNERAL_STATUS_LABELS[entry.newStatus]}</strong>
                    <small>{formatRequestDate(new Date(entry.createdAt).toISOString())} · {entry.changedByName}</small>
                    {entry.observation && <p>{entry.observation}</p>}
                  </div>
                </li>)}</ol>}
            </div>

            {availableStatuses.length > 0 ? <form className="request-update-form" onSubmit={submitStatus}>
              <h3>Registrar cambio de estado</h3>
              <label>Nuevo estado
                <select required value={nextStatus} onChange={(event) => setNextStatus(event.target.value as FuneralCaseStatusValue | "")}>
                  <option value="">Selecciona el nuevo estado</option>
                  {availableStatuses.map((status) => <option key={status} value={status}>{FUNERAL_STATUS_LABELS[status]}</option>)}
                </select>
              </label>
              <label>Observación <span>(opcional)</span>
                <textarea rows={3} maxLength={1000} value={observation} onChange={(event) => setObservation(event.target.value)} placeholder="Describe el motivo o detalle del cambio." />
              </label>
              <button className="primary-btn" type="submit" disabled={!nextStatus || updateStatus.isPending}>
                {updateStatus.isPending ? <RefreshCw size={15} /> : <Check size={15} />}
                {updateStatus.isPending ? "Guardando…" : "Guardar cambio"}
              </button>
            </form> : <p className="request-terminal-note">Este expediente tiene un estado terminal y no admite más cambios.</p>}
          </>}
      </section>
    </div>}
  </WorkspaceShell>;
}

const EMPLOYEE_FUNERAL_TRANSITIONS: Record<FuneralCaseStatusValue, FuneralCaseStatusValue[]> = {
  abierto: ["en_preparacion"],
  en_preparacion: ["programado", "en_ejecucion"],
  programado: ["en_preparacion", "en_ejecucion"],
  en_ejecucion: ["finalizado"],
  finalizado: [],
  cancelado: [],
};

function EmployeeFuneralCases({ session }: { session: AuthenticatedSession }) {
  const client = useQueryClient();
  const [search, setSearch] = useState("");
  const [statusFilter, setStatusFilter] = useState("");
  const [page, setPage] = useState(1);
  const [selectedId, setSelectedId] = useState<string | null>(null);
  const [nextStatus, setNextStatus] = useState<FuneralCaseStatusValue | "">("");
  const [observation, setObservation] = useState("");
  const [notice, setNotice] = useState("");
  const [error, setError] = useState("");

  const listQuery = useListEmployeeFuneralCases({
    search: search.trim() || undefined,
    status: statusFilter ? statusFilter as FuneralCaseStatusValue : undefined,
    page,
    limit: 20,
  });

  const detailQuery = useGetEmployeeFuneralCase(selectedId ?? "", {
    query: { enabled: Boolean(selectedId) },
  });

  const updateStatus = useUpdateEmployeeFuneralCaseStatus();
  const cases = listQuery.data?.funeralCases ?? [];
  const pagination = listQuery.data?.pagination;
  const selectedCase = detailQuery.data?.funeralCase;
  const history = detailQuery.data?.history ?? [];
  const availableStatuses = selectedCase
    ? EMPLOYEE_FUNERAL_TRANSITIONS[selectedCase.status]
    : [];

  function openDetail(id: string) {
    setError("");
    setNotice("");
    setNextStatus("");
    setObservation("");
    setSelectedId(id);
  }

  function submitStatus(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    if (!selectedId || !nextStatus) return;

    setError("");
    setNotice("");

    updateStatus.mutate({
      caseId: selectedId,
      data: {
        status: nextStatus,
        observation: observation.trim() || undefined,
      },
    }, {
      onSuccess: async () => {
        await Promise.all([
          client.invalidateQueries({ queryKey: getListEmployeeFuneralCasesQueryKey() }),
          client.invalidateQueries({ queryKey: getGetEmployeeFuneralCaseQueryKey(selectedId) }),
        ]);
        setNextStatus("");
        setObservation("");
        setNotice("El avance del expediente quedó registrado en el historial.");
      },
      onError: (mutationError) => {
        setError(getErrorMessage(mutationError, "No fue posible actualizar el expediente. Comprueba que siga asignado a tu cuenta."));
      },
    });
  }

  return <WorkspaceShell session={session}>
    <section className="page-content">
      <p className="page-kicker">GESTIÓN PERSONAL</p>
      <div className="page-heading-row">
        <div>
          <h1 className="page-title">Mi trabajo</h1>
          <p className="page-subtitle">Consulta los expedientes que tienes asignados y registra el avance de cada servicio.</p>
        </div>
      </div>

      {notice && <div className="success-banner" role="status">{notice}</div>}
      {error && !selectedId && <div className="page-inline-error" role="alert">{error}</div>}

      <div className="request-filters">
        <label className="request-search">
          <Search size={16} />
          <input
            aria-label="Buscar mis expedientes"
            value={search}
            onChange={(event) => { setSearch(event.target.value); setPage(1); }}
            placeholder="Buscar por número, fallecido o contacto…"
          />
        </label>
        <label className="request-status-filter">
          <span>Estado</span>
          <select value={statusFilter} onChange={(event) => { setStatusFilter(event.target.value); setPage(1); }}>
            <option value="">Todos los estados</option>
            {Object.entries(FUNERAL_STATUS_LABELS).map(([value, label]) =>
              <option key={value} value={value}>{label}</option>
            )}
          </select>
        </label>
      </div>

      <div className="table-wrap">
        <table className="employee-table request-table">
          <thead><tr>
            <th>Expediente</th>
            <th>Fallecido</th>
            <th>Contacto responsable</th>
            <th>Estado</th>
            <th>Creación</th>
            <th></th>
          </tr></thead>
          <tbody>
            {listQuery.isLoading
              ? <tr><td colSpan={6}><div className="loading-state">Cargando tus expedientes…</div></td></tr>
              : listQuery.isError
                ? <tr><td colSpan={6}><div className="error-state"><strong>No se pudieron cargar tus expedientes.</strong><p>Comprueba tu conexión e inténtalo de nuevo.</p><button className="secondary-btn" type="button" onClick={() => listQuery.refetch()}>Reintentar</button></div></td></tr>
                : cases.length === 0
                  ? <tr><td colSpan={6}><div className="empty-state"><strong>No tienes expedientes asignados con estos criterios.</strong><p>Cuando administración te asigne un expediente, aparecerá en esta sección.</p></div></td></tr>
                  : cases.map((item) => <tr key={item.id}>
                    <td><span className="request-reference-cell">{item.caseNumber}</span><small className="funeral-subline">Solicitud {item.serviceRequestReferenceCode}</small></td>
                    <td><strong>{item.deceasedFullName}</strong></td>
                    <td><div className="request-contact"><strong>{item.responsibleContactName}</strong><small>{item.responsibleContactPhone}</small></div></td>
                    <td><span className={\`pill request-status funeral-status-\${item.status}\`}>{FUNERAL_STATUS_LABELS[item.status]}</span></td>
                    <td>{formatRequestDate(new Date(item.createdAt).toISOString())}</td>
                    <td><button className="table-action" type="button" onClick={() => openDetail(item.id)}>Ver expediente</button></td>
                  </tr>)}
          </tbody>
        </table>
      </div>

      {pagination && <div className="request-pagination">
        <span>{pagination.total} expediente(s) · Página {pagination.page} de {pagination.totalPages}</span>
        <div>
          <button className="secondary-btn" type="button" disabled={pagination.page <= 1} onClick={() => setPage((value) => Math.max(1, value - 1))}>Anterior</button>
          <button className="secondary-btn" type="button" disabled={pagination.page >= pagination.totalPages} onClick={() => setPage((value) => value + 1)}>Siguiente</button>
        </div>
      </div>}
    </section>

    {selectedId && <div className="modal-backdrop request-detail-backdrop" onMouseDown={(event) => { if (event.target === event.currentTarget) setSelectedId(null); }}>
      <section className="modal request-detail-modal">
        <div className="modal-head">
          <div>
            <p className="page-kicker">MI EXPEDIENTE</p>
            <h2>{selectedCase?.caseNumber ?? "Expediente"}</h2>
            <p>Solicitud relacionada: {selectedCase?.serviceRequestReferenceCode ?? "Cargando…"}</p>
          </div>
          <button className="icon-button" type="button" aria-label="Cerrar" onClick={() => setSelectedId(null)}><X size={16} /></button>
        </div>

        {error && <div className="page-inline-error" role="alert">{error}</div>}

        {detailQuery.isLoading
          ? <div className="loading-state">Cargando expediente…</div>
          : detailQuery.isError || !selectedCase
            ? <div className="error-state"><strong>No se pudo cargar el expediente.</strong><p>Es posible que ya no esté asignado a tu cuenta.</p><button className="secondary-btn" type="button" onClick={() => detailQuery.refetch()}>Reintentar</button></div>
            : <>
              <div className="funeral-detail-status">
                <span className={\`pill request-status funeral-status-\${selectedCase.status}\`}>{FUNERAL_STATUS_LABELS[selectedCase.status]}</span>
                <span>Actualizado: {formatRequestDate(new Date(selectedCase.updatedAt).toISOString())}</span>
              </div>

              <div className="request-detail-grid">
                <div><small>Fallecido</small><strong>{selectedCase.deceasedFullName}</strong></div>
                <div><small>Fecha de fallecimiento</small><strong>{selectedCase.deceasedDateOfDeath ? formatRequestDate(new Date(selectedCase.deceasedDateOfDeath).toISOString()) : "No registrada"}</strong></div>
                <div><small>Lugar del servicio</small><strong>{selectedCase.serviceLocation || "No especificado"}</strong></div>
                <div><small>Contacto responsable</small><strong>{selectedCase.responsibleContactName}</strong></div>
                <div><small>Teléfono responsable</small><strong>{selectedCase.responsibleContactPhone}</strong></div>
                <div><small>Fecha de creación</small><strong>{formatRequestDate(new Date(selectedCase.createdAt).toISOString())}</strong></div>
              </div>

              {selectedCase.notes && <div className="request-notes"><small>Notas operativas</small><p>{selectedCase.notes}</p></div>}

              <div className="request-history">
                <h3><Clock3 size={16} /> Historial del expediente</h3>
                {history.length === 0
                  ? <p className="request-history-empty">No hay movimientos registrados.</p>
                  : <ol>{history.map((entry) => <li key={entry.id}>
                    <span className="request-history-dot" />
                    <div>
                      <strong>{entry.previousStatus ? \`\${FUNERAL_STATUS_LABELS[entry.previousStatus]} → \` : ""}{FUNERAL_STATUS_LABELS[entry.newStatus]}</strong>
                      <small>{formatRequestDate(new Date(entry.createdAt).toISOString())} · {entry.changedByName}</small>
                      {entry.observation && <p>{entry.observation}</p>}
                    </div>
                  </li>)}</ol>}
              </div>

              {availableStatuses.length > 0
                ? <form className="request-update-form" onSubmit={submitStatus}>
                  <h3>Registrar avance del servicio</h3>
                  <label>Nuevo estado
                    <select required value={nextStatus} onChange={(event) => setNextStatus(event.target.value as FuneralCaseStatusValue | "")}>
                      <option value="">Selecciona el nuevo estado</option>
                      {availableStatuses.map((status) => <option key={status} value={status}>{FUNERAL_STATUS_LABELS[status]}</option>)}
                    </select>
                  </label>
                  <label>Observación <span>(opcional)</span>
                    <textarea rows={3} maxLength={1000} value={observation} onChange={(event) => setObservation(event.target.value)} placeholder="Describe el avance o detalle del servicio." />
                  </label>
                  <button className="primary-btn" type="submit" disabled={!nextStatus || updateStatus.isPending}>
                    {updateStatus.isPending ? <RefreshCw size={15} /> : <Check size={15} />}
                    {updateStatus.isPending ? "Guardando…" : "Registrar avance"}
                  </button>
                </form>
                : <p className="request-terminal-note">Este expediente no admite más avances de estado.</p>}
            </>}
      </section>
    </div>}
  </WorkspaceShell>;
}

function ProtectedRoute({ session, children, adminOnly = false, employeeOnly = false }: { session: AuthenticatedSession; children: ReactNode; adminOnly?: boolean; employeeOnly?: boolean }) {
  if (session.user.mustChangePassword) {
    return <Redirect to="/change-password" />;
  }
  if (adminOnly && session.user.role !== "administrador") {
    return <Redirect to="/app" />;
  }
  if (employeeOnly && session.user.role !== "empleado") {
    return <Redirect to="/app" />;
  }
  return children;
}

function AppRoutes() {
  const [location] = useLocation();
  const sessionQuery = useGetAuthSession({ query: { queryKey: getGetAuthSessionQueryKey(), retry: false } });
  if (location === "/") return <PublicHomePage />;
  if (location === "/solicitar-servicio") return <PublicServiceRequest />;
  if (location === "/consultar-solicitud") return <PublicRequestLookup />;
  const unauthorized = isUnauthorized(sessionQuery.error);
  const session = unauthorized ? undefined : sessionQuery.data;
  if (sessionQuery.isLoading) return <AuthLoading />;
  if (sessionQuery.isError && !unauthorized) {
    return <div className="auth-layout"><AuthAside /><main className="auth-main"><section className="auth-card">
      <span className="state-symbol"><AlertCircle size={17} /></span><h2>No pudimos confirmar tu sesión.</h2><p className="auth-intro">Revisa tu conexión y vuelve a intentarlo.</p>
      <button className="primary-btn" data-testid="button-retry-session" onClick={() => sessionQuery.refetch()}><RefreshCw size={15} /> Reintentar</button>
    </section></main></div>;
  }
  return <Switch>
    <Route path="/personal"><SignIn session={session} /></Route>
    <Route path="/change-password">{session ? <PasswordChange session={session} /> : <Redirect to="/" />}</Route>
    <Route path="/app">{session ? <ProtectedRoute session={session}><EmployeeHome session={session} /></ProtectedRoute> : <Redirect to="/" />}</Route>
    <Route path="/mi-trabajo">{session ? <ProtectedRoute session={session} employeeOnly><EmployeeFuneralCases session={session} /></ProtectedRoute> : <Redirect to="/" />}</Route>
    <Route path="/admin/users">{session ? <ProtectedRoute session={session} adminOnly><AdminUsers session={session} /></ProtectedRoute> : <Redirect to="/" />}</Route>
    <Route path="/admin/service-offerings">{session ? <ProtectedRoute session={session} adminOnly><AdminServiceOfferings session={session} /></ProtectedRoute> : <Redirect to="/" />}</Route>
    <Route path="/admin/service-requests">{session ? <ProtectedRoute session={session} adminOnly><AdminServiceRequests session={session} /></ProtectedRoute> : <Redirect to="/" />}</Route>
    <Route path="/admin/funeral-cases">{session ? <ProtectedRoute session={session} adminOnly><AdminFuneralCases session={session} /></ProtectedRoute> : <Redirect to="/" />}</Route>
    <Route component={NotFound} />
  </Switch>;
}

function App() {
  return <QueryClientProvider client={queryClient}><div className="app-root"><AppRoutes /></div></QueryClientProvider>;
}

export default App;
