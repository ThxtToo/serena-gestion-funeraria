# Copia este archivo como .env y ajusta los valores.
# Nunca subas .env al repositorio (ya está en .gitignore).

# --- Base de datos (obligatorio) ---
# PostgreSQL. En local suele ser 127.0.0.1:5432.
DATABASE_URL=postgresql://serena:serena@127.0.0.1:5432/serena

# --- Sesiones (obligatorio) ---
# Secreto largo y aleatorio, mínimo 32 caracteres. Genéralo con:
#   openssl rand -base64 48
SESSION_SECRET=reemplaza-esto-por-un-secreto-largo-y-aleatorio

# --- Servidor ---
# Puerto del API. Vite también exige PORT al compilar el frontend,
# así que en desarrollo se lanza aparte (por ejemplo PORT=5173).
PORT=3000

# Ruta base del frontend. Replit la inyecta; en local normalmente "/".
BASE_PATH=/

# Nivel de logs: trace | debug | info | warn | error
LOG_LEVEL=info

# --- Agente de IA ---
# Solo backend. Nunca exponer esta clave al navegador.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Atención humana ---
# Canales reales de la funeraria. Si no se configuran, el agente informa
# que el canal todavía no está disponible en lugar de inventar datos.
# SERENA_SUPPORT_PHONE=
# SERENA_SUPPORT_EMAIL=
